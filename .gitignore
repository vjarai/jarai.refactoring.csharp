## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Bb]in/
[Oo]bj/
out/
artifacts/

# Visual Studio workspace
.vs/

# Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json
.packages

# Dotnet publish
*.publishsettings
*.pubxml
*.azurePubxml
publish/
PublishScripts/

# Web
wwwroot/node_modules/
node_modules/

# Test results
[Tt]est[Rr]esult*/
TestResult.xml
*.trx

# Logs
*.log

# Visual Studio cache / generated files
Generated Files/
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj

# Coverage / profiling
*.coverage
*.coveragexml
BenchmarkDotNet.Artifacts/
OpenCover/

# Tooling
.DS_Store
.cache
*.dotCover

# Package managers
.paket/
paket-files/

# Secrets / local settings
secrets.json
*.usersecrets

# SQL Server files
*.mdf
*.ldf

# Others
*.dbmdl
*.jfm
*.pfx

# MSBuild binary logs
*.binlog

# Keep this repo clean: ignore local-only generated files
/_UpgradeReport_Files/
Backup*/